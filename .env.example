# Copia este archivo como ".env" y completa los valores.
# Para SECRET_KEY ejecutar este comando: python -c "import secrets; print(secrets.token_urlsafe(50))" y pegar el resultado sin comillas
SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cadena de conexión de Supabase (Project Settings > Database > Connection string > URI).
# Si la dejas vacía, el sistema usa SQLite local (db.sqlite3).
# Ejemplo: postgresql://postgres.xxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Pool de conexiones (recomendado con Supabase). Ponlo en False solo si te da problemas.
DB_POOL=True
DB_POOL_MAX=3

# Opcional: habilita la propuesta de importancia sugerida con un modelo de lenguaje.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
